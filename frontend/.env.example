# ───────────────────────────────────────────────
# Supabase 프론트엔드 환경변수
# Supabase 대시보드 → Project Settings → API에서 확인
# ───────────────────────────────────────────────

# Supabase 프로젝트 URL (예: https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key (공개 가능, RLS가 보호)
VITE_SUPABASE_ANON_KEY=

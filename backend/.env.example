# ───────────────────────────────────────────────
# Supabase 백엔드 환경변수
# Supabase 대시보드 → Project Settings에서 확인
# ───────────────────────────────────────────────

# Supabase 프로젝트 URL (예: https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase anon key
SUPABASE_ANON_KEY=

# Supabase Service Role Key — Admin API 호출용 (대시보드 → Settings → API → service_role)
# ⚠️ 절대 프론트엔드에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# 사번 이메일 도메인 (mes001@[domain] 형식으로 Supabase Auth 계정 생성)
EMP_EMAIL_DOMAIN=mes.local

# PostgreSQL 직접 연결 (Supabase 대시보드 → Project Settings → Database → Connection String)
# Direct Connection 탭의 URI 사용 (Transaction pooler 아닌 것)
SUPABASE_DB_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

SUPABASE_SERVICE_ROLE_KEY=   ← Supabase 대시보드 → Settings → API → service_role
EMP_EMAIL_DOMAIN=mes.local   ← 원하는 도메인으로 변경 가능
